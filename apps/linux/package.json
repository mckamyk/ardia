{
  "name": "@ardia/linux",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test:host": "node --experimental-strip-types --import ./scripts/host-test-loader.mjs --test src/host.test.mjs src/hostContract.test.mjs src/hostSessionMerge.test.mjs src/hostSessionSync.test.mjs src/session.test.mjs src/settingsWindows.test.mjs src/hostViewport.test.mjs src/hostViewportPresentation.test.mjs src/shortcuts.test.mjs",
    "test:symbols": "node --experimental-strip-types --test src/shims/web/symbols/render.test.mjs",
    "test:graph": "node --test scripts/module-graph.test.mjs",
    "fixture:csp": "node scripts/host-csp-fixture.mjs",
    "test:keyboard-native": "node scripts/keyboard-native-test.mjs"
  },
  "dependencies": {
    "@ardia/core": "workspace:*",
    "@ardia/ardiacore": "workspace:*",
    "@ardia/import": "workspace:*",
    "@ardia/shaders": "workspace:*",
    "@ardia/shell": "workspace:*",
    "@ardia/sync": "workspace:*",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native-web": "^0.21.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "rollup-plugin-visualizer": "^6.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.9"
  }
}
