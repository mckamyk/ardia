 }
 
+// Ardia: ArdiaCore (engine/ardiacore) keeps its windows open without tabs.
+bool (*g_ardia_keeps_window_without_tabs)(
+    const BrowserWindowInterface* browser) = nullptr;
+
 void Browser::TabStripEmpty() {
+  // Ardia: a window ArdiaCore shows its own UI in stays open without tabs,
+  // unless it is closing.
+  if (g_ardia_keeps_window_without_tabs &&
+      g_ardia_keeps_window_without_tabs(this) &&
+      !UnloadController::From(this)->is_attempting_to_close_browser()) {
+    return;
+  }
   // Note: even though the tab strip is empty, the call to Close() may not
   // result in closing this Browser. This can happen in the case of closing
   // the last Browser with ongoing downloads.
