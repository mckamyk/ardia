+#if BUILDFLAG(IS_LINUX)
+void DevToolsWindow::RegisterLinuxDevToolsLifecycle() {
+  ardiacore::InstallLinuxDevToolsDispatcher(
+      [](content::WebContents* contents, ardiacore::LinuxDevToolsAction action,
+         std::shared_ptr<ardiacore::LinuxDevToolsLease> lease,
+         base::OnceClosure ready) {
+        if (!lease || !lease->Matches(contents)) return false;
+        auto* tools = GetInstanceForInspectedWebContents(contents);
+        if (action == ardiacore::LinuxDevToolsAction::kToggle && tools &&
+            tools->IsDocked()) {
+          tools->BindLinuxDevToolsLease(lease, false);
+          tools->CloseWindow();
+          return true;
+        }
+        const auto toggle = action == ardiacore::LinuxDevToolsAction::kInspect
+            ? DevToolsToggleAction::Inspect()
+            : action == ardiacore::LinuxDevToolsAction::kConsole
+                ? DevToolsToggleAction::ShowConsolePanel()
+                : DevToolsToggleAction::Show();
+        ardiacore::ScopedLinuxDevToolsOperation operation(contents, lease);
+        OpenDevToolsWindow(contents, toggle,
+                          DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+        if (!lease->Matches(contents)) return false;
+        tools = GetInstanceForInspectedWebContents(contents);
+        if (!tools || tools->linux_devtools_state_.Capture().lease != lease) return false;
+        tools->SetLoadCompletedCallback(base::BindOnce(
+            [](base::WeakPtr<DevToolsWindow> window,
+               ardiacore::LinuxDevToolsTicket ticket, base::OnceClosure callback) {
+              if (window && window->linux_devtools_state_.IsCurrent(ticket) && callback)
+                std::move(callback).Run();
+            }, tools->weak_factory_.GetWeakPtr(),
+            tools->linux_devtools_state_.Capture(), std::move(ready)));
+        return true;
+      });
+}
+
+void DevToolsWindow::BindLinuxDevToolsLease(
+    std::shared_ptr<ardiacore::LinuxDevToolsLease> lease, bool created) {
+  if (linux_devtools_state_.has_pending_close() && life_stage_ == kClosing)
+    life_stage_ = linux_close_stage_;
+  linux_devtools_state_.Begin(lease, created);
+  if (lease) {
+    lease->OnRevoke(base::BindOnce(&DevToolsWindow::RevokeLinuxDevToolsLease,
+        weak_factory_.GetWeakPtr(), linux_devtools_state_.Capture().epoch));
+  }
+}
+
+void DevToolsWindow::RevokeLinuxDevToolsLease(uint64_t epoch) {
+  if (linux_devtools_state_.Capture().epoch != epoch) return;
+  action_on_load_ = DevToolsToggleAction::NoOp();
+  load_completed_callback_.Reset();
+  if (!linux_devtools_state_.OwnsFrontend(epoch)) return;
+  auto weak = weak_factory_.GetWeakPtr();
+  if (auto* view = main_web_contents_->GetNativeView()) view->Hide();
+  if (!weak || !weak->linux_devtools_state_.OwnsFrontend(epoch)) return;
+  if (!weak->is_docked_ && weak->browser_) weak->browser_->GetWindow()->Hide();
+}
+#endif
