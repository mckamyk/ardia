+std::vector<std::pair<MediaPlayerId, bool>>
+MediaWebContentsObserver::ArdiaLinuxPictureInPictureCandidates(
+    GlobalRenderFrameHostId frame) {
+  std::vector<std::pair<MediaPlayerId, bool>> candidates;
+  for (const auto& [id, info] : player_info_map_) {
+    if (id.frame_routing_id != frame || !info->has_video() ||
+        !media_player_remotes_.contains(id) ||
+        !session_controllers_manager()->ArdiaLinuxPictureInPictureAvailable(id)) {
+      continue;
+    }
+    candidates.emplace_back(id, info->is_playing());
+  }
+  return candidates;
+}
+
+bool MediaWebContentsObserver::ArdiaLinuxRequestPictureInPicture(
+    const MediaPlayerId& id) {
+  const auto it = media_player_remotes_.find(id);
+  if (it == media_player_remotes_.end() || !it->second.is_bound()) {
+    return false;
+  }
+  it->second->RequestEnterPictureInPicture(std::nullopt);
+  return true;
+}
+
+std::vector<std::pair<MediaPlayerId, bool>>
+ArdiaLinuxPictureInPictureCandidates(WebContents* contents) {
+  auto* impl = static_cast<WebContentsImpl*>(contents);
+  MediaWebContentsObserver* observer =
+      impl ? impl->media_web_contents_observer() : nullptr;
+  if (!observer) {
+    return {};
+  }
+  return observer->ArdiaLinuxPictureInPictureCandidates(
+      contents->GetPrimaryMainFrame()->GetGlobalId());
+}
+
+bool ArdiaLinuxRequestPictureInPicture(WebContents* contents,
+                                       const MediaPlayerId& id) {
+  auto* impl = static_cast<WebContentsImpl*>(contents);
+  MediaWebContentsObserver* observer =
+      impl ? impl->media_web_contents_observer() : nullptr;
+  return observer && id.frame_routing_id ==
+                         contents->GetPrimaryMainFrame()->GetGlobalId() &&
+         observer->ArdiaLinuxRequestPictureInPicture(id);
+}
+#endif
+
 }  // namespace content
