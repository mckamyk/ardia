assert(is_linux)

import("//pdf/features.gni")
import("//printing/buildflags/buildflags.gni")

action("bootstrap") {
  script = "generate_bootstrap.py"
  sources = [ "bootstrap.js" ]
  outputs = [ "$target_gen_dir/host_bootstrap.h" ]
  args = [
    "--input",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

source_set("close_hooks") {
  sources = [
    "ac_linux_close_hooks.cc",
    "ac_linux_close_hooks.h",
  ]
  deps = [ "//base" ]
}

source_set("devtools_authority") {
  sources = [
    "ac_linux_devtools_authority.cc",
    "ac_linux_devtools_authority.h",
  ]
  deps = [
    "//base",
    "//content/public/browser",
  ]
}

source_set("linux") {
  sources = [
    "ac_linux_close.h",
    "ac_linux_contract.h",
    "ac_linux_dialog_views.cc",
    "ac_linux_dialog_views.h",
    "ac_linux_dialogs.cc",
    "ac_linux_dialogs.h",
    "ac_linux_document_reducer.cc",
    "ac_linux_document_reducer.h",
    "ac_linux_document_schema.cc",
    "ac_linux_document_service.cc",
    "ac_linux_document_service.h",
    "ac_linux_documents.cc",
    "ac_linux_documents.h",
    "ac_linux_download_service.cc",
    "ac_linux_download_service.h",
    "ac_linux_downloads.cc",
    "ac_linux_downloads.h",
    "ac_linux_file_drop.cc",
    "ac_linux_file_drop.h",
    "ac_linux_files.cc",
    "ac_linux_files.h",
