assert(is_linux)

action("bootstrap") {
  script = "generate_bootstrap.py"
  sources = [ "bootstrap.js" ]
  outputs = [ "$target_gen_dir/host_bootstrap.h" ]
  args = [
    "--input",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

source_set("close_hooks") {
  sources = [
    "ac_linux_close_hooks.cc",
    "ac_linux_close_hooks.h",
  ]
  deps = [ "//base" ]
}

source_set("linux") {
  sources = [
    "ac_linux_close.h",
    "ac_linux_contract.h",
    "ac_linux_dialog_views.cc",
    "ac_linux_dialog_views.h",
    "ac_linux_dialogs.cc",
    "ac_linux_dialogs.h",
    "ac_linux_document_reducer.cc",
    "ac_linux_document_reducer.h",
    "ac_linux_document_schema.cc",
    "ac_linux_document_service.cc",
    "ac_linux_document_service.h",
    "ac_linux_documents.cc",
    "ac_linux_documents.h",
    "ac_linux_host.cc",
    "ac_linux_host.h",
    "ac_linux_policy.h",
    "ac_linux_session.cc",
    "ac_linux_session.h",
    "ac_linux_window_lifecycle.cc",
    "ac_linux_window_lifecycle.h",
  ]
  sources += get_target_outputs(":bootstrap")
  deps = [
    ":bootstrap",
    ":close_hooks",
    "//ardia/core:launch_switches",
    "//base",
    "//chrome/browser",
    "//chrome/browser/ardia",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_window_state",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/common",
    "//components/content_settings/core/browser",
    "//components/prefs",
    "//components/sessions",
    "//components/search_engines",
    "//components/tabs:public",
    "//components/zoom",
    "//components/version_info",
    "//components/viz/common",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/base/mojom",
    "//ui/base/mojom:ui_base_types",
    "//ui/aura",
    "//ui/color",
    "//ui/compositor",
    "//ui/display",
    "//ui/base/clipboard",
    "//ui/gfx",
